# Downloaded building blocks and build output — regenerated, never committed
node_modules/
dist/
design-system-dist/
*.tsbuildinfo
.DS_Store
.vite/
# Secrets stay on your computer: environment files are never committed (an .env.example with blank values is)
.env
.env.*
!.env.example
# Renders and files the Claude desktop app saves while you work — they stay on your computer, not in the repo
Claude outputs/
# package-lock.json is committed on purpose: it freezes exact versions for Vercel.
# The packaged team plugin: rebuilt from kit/ and shared as a file, not committed
kit/*.plugin
