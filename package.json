{
  "name": "modus-instrument",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Modus Instrument — UI foundation: tokens, Base UI components and Insight Center patterns.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "logo": "node scripts/build-logo.mjs",
    "dev": "npm run tokens && vite",
    "build": "npm run tokens && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "ds:build": "npm run tokens && node scripts/build-design-system.mjs",
    "new": "node scripts/create-project.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "allowScripts": {
    "esbuild": true,
    "@parcel/watcher": true
  }
}
